<?xml version="1.0"?>
<launch>
  <arg name="joy_dev" default="/dev/input/js0"/>
  <arg name="teleop_joy_config" default="$(find-pkg-share sphero_rvr_controllers)/config/joy_config.yaml"/>
  <arg name="twist_mux_config" default="$(find-pkg-share sphero_rvr_controllers)/config/twist_mux.yaml"/>

  <!-- spawn joint state broadcaster -->
  <node pkg="controller_manager" exec="spawner" name="joint_state_broadcaster_spawner"
        args="joint_state_broadcaster"/>

  <!-- spawn diff drive controller -->
  <node pkg="controller_manager" exec="spawner" name="diff_drive_controller_spawner"
    args="diff_drive_controller --param-file $(find-pkg-share sphero_rvr_controllers)/config/diff_drive_controller.yaml"/>

  <!-- joy driver -->
  <node pkg="joy" exec="joy_node" name="joy_node">
    <param name="device_id" value="$(var joy_dev)"/>
    <param name="deadzone" value="0.3"/>
    <param name="autorepeat_rate" value="20.0"/>
  </node>

  <!-- teleop twist joy -->
  <node pkg="teleop_twist_joy" exec="teleop_node" name="teleop_twist_joy">
    <remap from="cmd_vel" to="/joy_teleop/cmd_vel"/>
    <param from="$(var teleop_joy_config)"/>
  </node>

  <!-- twist mux -->
  <node pkg="twist_mux" exec="twist_mux" name="twist_mux" output="screen">
    <remap from="cmd_vel_out" to="/controller/tracks/cmd_vel"/>
    <param from="$(var twist_mux_config)"/>
  </node>
</launch>
