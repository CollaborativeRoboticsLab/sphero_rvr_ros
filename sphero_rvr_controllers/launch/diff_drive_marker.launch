<?xml version="1.0"?>
<launch>
  <arg name="config_file" default="$(find-pkg-share sphero_rvr_controllers)/config/diff_drive_marker.yaml"/>

  <!-- diff drive controller interactive marker -->
  <node pkg="interactive_marker_twist_server" exec="marker_server" name="diff_drive_marker">
    <param from="$(var config_file)"/>
    <remap from="cmd_vel" to="diff_drive_marker/cmd_vel" />
  </node>
</launch>
