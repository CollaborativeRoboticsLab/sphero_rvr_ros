<?xml version="1.0"?>
<launch>
  <!-- filter parameters -->
  <arg name="ekf_local_config" default="$(find-pkg-share sphero_rvr_navigation)/config/localisation.yaml" />

  <!-- filters -->
  <node pkg="robot_localization" exec="ekf_node" name="ekf_local" >
    <param from="$(var ekf_local_config)" />
    <param name="imu0" value="/imu_sensor_broadcaster/imu" />
    <remap from="odometry/filtered" to="odometry/filtered/local" />
  </node>

</launch>
