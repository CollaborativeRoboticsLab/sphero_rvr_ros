<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="track_robot">

    <!--common-->
    <xacro:include filename="$(find sphero_rvr_description)/urdf/common.urdf.xacro" />
    <xacro:include filename="$(find sphero_rvr_description)/urdf/materials.urdf.xacro" />
    <xacro:include filename="$(find sphero_rvr_description)/urdf/geometry.urdf.xacro" />

    <!-- parts -->
    <xacro:include filename="$(find sphero_rvr_description)/urdf/body.urdf.xacro" />
    <xacro:include filename="$(find sphero_rvr_description)/urdf/wheel.urdf.xacro" />

    <!-- urg laser -->
    <xacro:include filename="$(find urg_node)/urdf/hokuyo_ust10.urdf.xacro" />

    <!-- arguments -->
    <!-- simulation awareness for ros2 control -->
    <xacro:arg name="use_sim" default="false"/>

    <!-- dummy base link no inertia to satisfy kdl -->
    <link name="base_link"/>

    <!-- Base footprint is on the ground under the robot -->
    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
        <origin xyz="0 0 ${rvr_track_dz - rvr_wheel_radius}" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="base_footprint" />
    </joint>

    <!-- attach body to base_link -->
    <joint name="body_inertia" type="fixed">
        <parent link="base_link" />
        <child link="body" />
    </joint>

    <!-- body acting as base link inertia -->
    <xacro:body name="body" />

    <!-- tracks -->
    <xacro:wheel name="left_track_back_wheel" parent="base_link" direction="1" >
        <origin xyz="-${rvr_track_length/2} ${rvr_body_width/2} ${rvr_track_dz}" rpy="0 0 0" />
    </xacro:wheel>
    <xacro:wheel name="left_track_front_wheel" parent="base_link" direction="1">
        <origin xyz="${rvr_track_length/2} ${rvr_body_width/2} ${rvr_track_dz}" rpy="0 0 0" />
    </xacro:wheel>

    <xacro:wheel name="right_track_back_wheel" parent="base_link" direction="-1" >
        <origin xyz="-${rvr_track_length/2} -${rvr_body_width/2} ${rvr_track_dz}" rpy="${M_PI} 0 0" />
    </xacro:wheel>
    <xacro:wheel name="right_track_front_wheel" parent="base_link" direction="-1">
        <origin xyz="${rvr_track_length/2} -${rvr_body_width/2} ${rvr_track_dz}" rpy="${M_PI} 0 0" />
    </xacro:wheel>

    <!-- laser -->
    <xacro:hokuyo_ust10_mount parent_link="base_link" prefix="urg" topic="scan" >
        <origin xyz="${-0.03} 0 ${rvr_body_height + 0.035}" rpy="0 0 0" />
    </xacro:hokuyo_ust10_mount>

    <!-- gazebo extras -->
    <!-- gazebo control -->
    <gazebo>
        <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="gz_ros2_control-system">
            <parameters>$(find sphero_rvr_control)/config/control.yaml</parameters>
        </plugin>
    </gazebo>

    <!-- imu -->
    <!-- TODO test imu in ros2 sim -->
    <gazebo reference="base_link">
        <sensor type="imu" name="imu_sensor">
            <always_on>true</always_on>
            <update_rate>10.0</update_rate>
            <topic>imu</topic>
            <frame_id>base_link</frame_id>
            <plugin name="gz::sim::systems::Imu" filename="libgz-sim-imu-system.so"/>
        </sensor>
    </gazebo>

    <!-- gps -->
    <gazebo reference="base_link">
        <sensor type="gps" name="gps_sensor">
            <always_on>true</always_on>
            <update_rate>1.0</update_rate>
            <topic>fix</topic>
            <frame_id>base_link</frame_id>
            <plugin name="gz::sim::systems::NavSat" filename="libgz-sim-navsat-system.so"/>
        </sensor>
    </gazebo>

    <!-- ros2_control hardware interface and joint interfaces -->
    <ros2_control name="SpheroRvrSystem" type="system">
        <hardware>
            <xacro:if value="$(arg use_sim)">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </xacro:if>
            <xacro:unless value="$(arg use_sim)">
                <plugin>sphero_rvr_control/SpheroRvrHardwareInterface</plugin>
                <param name="simulated">false</param>
                <param name="device_port">/dev/serial0</param>
                <param name="baud_rate">115200</param>
                <param name="max_wheel_velocity_rad_s">10.0</param>
                <!-- encoder ticks per revolution -->
                <param name="ticks_per_revolution">4096</param>
                <param name="enable_imu">true</param>
                <param name="imu_hz">10</param>
                <param name="enable_light_sensors">true</param>
                <param name="sensor_poll_hz">2.0</param>
            </xacro:unless>
        </hardware>

        <!-- IMU -->
        <sensor name="imu_sensor">
            <state_interface name="orientation.w"/>
            <state_interface name="orientation.x"/>
            <state_interface name="orientation.y"/>
            <state_interface name="orientation.z"/>
            <state_interface name="angular_velocity.x"/>
            <state_interface name="angular_velocity.y"/>
            <state_interface name="angular_velocity.z"/>
            <state_interface name="linear_acceleration.x"/>
            <state_interface name="linear_acceleration.y"/>
            <state_interface name="linear_acceleration.z"/>
        </sensor>

        <!-- Ambient light sensor -->
        <sensor name="ambient_light_sensor">
            <state_interface name="ambient_light"/>
        </sensor>

        <!-- Color sensor -->
        <sensor name="color_sensor">
            <state_interface name="color_r"/>
            <state_interface name="color_g"/>
            <state_interface name="color_b"/>
            <state_interface name="color_c"/>
        </sensor>

        <!-- velocity command and state interfaces for each wheel joint -->
        <joint name="left_track_back_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
        <joint name="left_track_front_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
        <joint name="right_track_back_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
        <joint name="right_track_front_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
    </ros2_control>
</robot>
