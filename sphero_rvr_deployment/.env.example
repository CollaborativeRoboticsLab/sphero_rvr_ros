# Sphero RVR Deployment Configuration
# This file contains environment variables and parameters for deployment

# ROS 2 Configuration
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ROS_LOCALHOST_ONLY=0
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
# optional, defaults will cover most use cases
DISCOVERY_SERVER_IP=127.0.0.1
DISCOVERY_SERVER_PORT=11811
ROS_SUPER_CLIENT=True

# MQTT Fleet Logger Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=fleet/rvr
ROBOT_ID=rvr-001

# Hardware Configuration
SERIAL_PORT=/dev/serial0
I2C_BUS=/dev/i2c-1

# driver source
RVR_DRIVER_SOURCE=https://github.com/collaborativeroboticslab/sphero_rvr_driver_py.git
