# Sphero RVR Deployment Configuration
# This file contains environment variables and parameters for deployment

# ROS 2 Configuration
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# MQTT Fleet Logger Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=fleet/rvr
ROBOT_ID=rvr-001

# Hardware Configuration
SERIAL_PORT=/dev/serial0
I2C_BUS=/dev/i2c-1

# driver source
RVR_DRIVER_SOURCE=https://github.com/collaborativeroboticslab/sphero_rvr_driver_py.git
